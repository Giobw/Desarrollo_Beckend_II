{
  "info": {
    "name": "PetSalud - Pruebas de seguridad",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:8080"
    },
    {
      "key": "tokenGerente",
      "value": ""
    },
    {
      "key": "tokenEmpleado",
      "value": ""
    },
    {
      "key": "tokenCliente",
      "value": ""
    },
    {
      "key": "tokenFalso",
      "value": "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJnZXJlbnRlQHBldHNhbHVkLmNsIn0.firma-invalida"
    }
  ],
  "item": [
    {
      "name": "1. Autenticacion",
      "item": [
        {
          "name": "Login GERENTE",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"gerente@petsalud.cl\", \"password\": \"Gerente123!\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200',()=>pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tokenGerente', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login EMPLEADO",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"empleado@petsalud.cl\", \"password\": \"Empleado123!\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200',()=>pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tokenEmpleado', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login CLIENTE",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"cliente@petsalud.cl\", \"password\": \"Cliente123!\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200',()=>pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tokenCliente', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con credenciales invalidas",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"cliente@petsalud.cl\", \"password\": \"mala\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registro publico (rol forzado a CLIENTE)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/api/auth/registro",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"nuevo@correo.cl\", \"password\": \"Clave12345\", \"nombre\": \"Nuevo\", \"apellido\": \"Cliente\", \"rol\": \"GERENTE\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Autorizacion por rol",
      "item": [
        {
          "name": "Sin token -> 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/api/usuarios"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "CLIENTE lista usuarios -> 403",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCliente}}"
              }
            ],
            "url": "{{base}}/api/usuarios"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "EMPLEADO lista usuarios -> 403",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenEmpleado}}"
              }
            ],
            "url": "{{base}}/api/usuarios"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "GERENTE lista usuarios -> 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenGerente}}"
              }
            ],
            "url": "{{base}}/api/usuarios"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "CLIENTE crea producto -> 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCliente}}"
              }
            ],
            "url": "{{base}}/api/productos",
            "body": {
              "mode": "raw",
              "raw": "{\"nombre\": \"Collar\", \"categoria\": \"Accesorios\", \"precio\": 5990, \"stock\": 10}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "EMPLEADO crea producto -> 200",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenEmpleado}}"
              }
            ],
            "url": "{{base}}/api/productos",
            "body": {
              "mode": "raw",
              "raw": "{\"nombre\": \"Collar\", \"categoria\": \"Accesorios\", \"precio\": 5990, \"stock\": 10}"
            }
          }
        },
        {
          "name": "EMPLEADO elimina producto -> 403 (solo GERENTE)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenEmpleado}}"
              }
            ],
            "url": "{{base}}/api/productos/1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "CLIENTE ve ventas globales -> 403",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCliente}}"
              }
            ],
            "url": "{{base}}/api/ventas"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "CLIENTE ve datos de otro usuario (IDOR) -> 403",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCliente}}"
              }
            ],
            "url": "{{base}}/api/usuarios/1"
          }
        }
      ]
    },
    {
      "name": "3. Token manipulado / expirado",
      "item": [
        {
          "name": "Token alterado -> 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenFalso}}"
              }
            ],
            "url": "{{base}}/api/productos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. SQL Injection",
      "item": [
        {
          "name": "Login con ' OR '1'='1 -> 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"' OR '1'='1\", \"password\": \"' OR '1'='1\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('No autentica (400 o 401)',()=>pm.expect([400,401]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Parametro categoria con inyeccion",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCliente}}"
              }
            ],
            "url": "{{base}}/api/productos/categoria?categoria=x'%20OR%20'1'='1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Sin error SQL ni datos extra',()=>pm.expect(pm.response.text()).to.not.include('SQL'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. XSS",
      "item": [
        {
          "name": "Registro con <script> en nombre",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/api/auth/registro",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"xss@correo.cl\", \"password\": \"Clave12345\", \"nombre\": \"<script>alert(1)</script>\", \"apellido\": \"Test\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Nombre escapado',()=>pm.expect(pm.response.json().nombre).to.not.include('<script>'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. CSRF",
      "item": [
        {
          "name": "POST sin token (simula formulario externo) -> 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/api/productos",
            "body": {
              "mode": "raw",
              "raw": "{\"nombre\": \"x\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}